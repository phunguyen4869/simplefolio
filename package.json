{
  "name": "simplefolio",
  "version": "1.0.1",
  "private": true,
  "description": "Personal portfolio of Phú Nguyễn, Senior Full Stack Developer",
  "source": [
    "src/index.html",
    "src/vi.html"
  ],
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true
    }
  },
  "scripts": {
    "i18n": "node scripts/build-vi.mjs",
    "prestart": "npm run i18n",
    "start": "parcel",
    "prebuild": "npm run i18n",
    "build": "rm -rf dist && parcel build --public-url ./ && cp src/assets/og-image.jpg dist/og-image.jpg",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phunguyen4869/simplefolio.git"
  },
  "keywords": [],
  "author": "Phú Nguyễn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phunguyen4869/simplefolio/issues"
  },
  "homepage": "https://phunguyen4869.github.io/simplefolio/",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@parcel/transformer-sass": "^2.16.4",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=18"
  }
}
